# Examples only. Store real values in a private runtime, never in Git/chat.
# Copy the Session pooler host from Supabase Connect, do not infer it from the region.
# Use a dedicated database login, NOT postgres or service_role.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full
OPENAI_API_KEY=
# Set a model available to your API project. No automatic fallback.
OPENAI_MODEL=
PORTFOLIO_WORKSPACE=.
# Nothing starts until the owner explicitly enrolls a project and resumes.
